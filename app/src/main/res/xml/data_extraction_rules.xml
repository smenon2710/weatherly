<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher: same rule as backup_rules.xml, for both cloud backup and
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="weatherly_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="weatherly_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
