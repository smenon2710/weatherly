<?xml version="1.0" encoding="utf-8"?>
<!--
    Sun glyph for the Weatherly launcher icon.
    Viewport is 108×108; all content sits inside the 72dp safe zone (18–90).
    Palette matches WeatherGlyph.kt: SunColor #E0B15C on transparent.
    Core circle r=14 at center (54,54); 8 rays inner r=19, outer r=27, width 4dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 8 rays at 45° intervals (rounded caps) -->
    <!-- Up -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,35 L54,27" />
    <!-- Upper-right -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M67,41 L73,35" />
    <!-- Right -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M73,54 L81,54" />
    <!-- Lower-right -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M67,67 L73,73" />
    <!-- Down -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,73 L54,81" />
    <!-- Lower-left -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M41,67 L35,73" />
    <!-- Left -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M35,54 L27,54" />
    <!-- Upper-left -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M41,41 L35,35" />

    <!-- Sun core circle — two arcs to form a closed circle (r=14, center 54,54) -->
    <path
        android:fillColor="#E0B15C"
        android:pathData="M40,54 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 z" />

</vector>
