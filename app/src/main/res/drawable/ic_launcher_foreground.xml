<?xml version="1.0" encoding="utf-8"?>
<!--
    SkySpeak launcher icon foreground.
    Viewport is 108×108; all content sits inside the 72dp safe zone (18–90).
    Palette: warm-gold #E0B15C (sun + waves) on transparent.
    Sun: core circle r=14 at center (54,54); 8 rays inner r=19, outer r=27, width 4dp.
    Speech waves: three concentric arcs to the right of the sun, suggesting sky + speak.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 8 rays at 45° intervals (rounded caps) -->
    <!-- Up -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,35 L54,27" />
    <!-- Upper-right -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M67,41 L73,35" />
    <!-- Right -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M73,54 L81,54" />
    <!-- Lower-right -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M67,67 L73,73" />
    <!-- Down -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,73 L54,81" />
    <!-- Lower-left -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M41,67 L35,73" />
    <!-- Left -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M35,54 L27,54" />
    <!-- Upper-left -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M41,41 L35,35" />

    <!-- Sun core circle — two arcs to form a closed circle (r=14, center 54,54) -->
    <path
        android:fillColor="#E0B15C"
        android:pathData="M40,54 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 z" />

    <!-- Speech waves — three concentric arcs emanating right from the sun (the "speak" in SkySpeak).
         Each arc is centered on the sun (54,54), sweeping from ~-40° to +40°, at r=20/25/30.
         Opacity decreases outward to suggest sound fading into the sky. -->
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M69,43 A20,20 0 0,1 69,65" />
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:alpha="0.6"
        android:pathData="M74,39 A25,25 0 0,1 74,69" />
    <path
        android:strokeColor="#E0B15C"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:alpha="0.35"
        android:pathData="M79,35 A30,30 0 0,1 79,73" />

</vector>
