<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather lookups + reverse geocoding need the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Location: COARSE is enough for city-level weather. FINE is optional. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Optional, user-granted separately from the two above (Settings → Background Location):
         lets WeatherAlertWorker resolve the device's live location when no place is explicitly
         selected, instead of only working for a saved place. Sideload-testing only for now — see
         NOTIFICATIONS_ROADMAP.md for the Play Console "background location" review this would
         need before ever shipping to Production. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Normal permission (no runtime prompt) that unlocks ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
         — a direct, one-tap system dialog asking the user to exempt this app from Doze/App
         Standby battery restrictions, offered (never forced) via Settings → Battery Optimization
         and the missing-setup prompt on the Weather screen, only relevant once a background
         notification feature is actually enabled. Google Play reserves this specifically for apps
         whose core functionality is degraded without it, which is exactly this app's case: OEM
         battery managers (Samsung, Xiaomi, and others) are well known to kill/throttle background
         WorkManager jobs well beyond stock Android's own Doze behavior — see
         NOTIFICATIONS_ROADMAP.md and PLAYSTORE_LAUNCH.md's non-Pixel testing gap notes. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Normal permission, no runtime prompt: a single restrained haptic pulse for notable
         conditions (severe alert, thunderstorm, heavy rain/snow). See util/WeatherHaptics.kt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Runtime-prompted on API 33+ only (below that, posting to a channel needs no grant at
         all). Gates the optional background weather-alert notifications feature (Settings
         toggle, off by default) — see notifications/WeatherAlertWorker.kt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Weatherly">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Weatherly"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.WeatherWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>
    </application>
</manifest>
